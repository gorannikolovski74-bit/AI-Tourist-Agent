<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AiTouristAgent" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="21">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <style name="Theme.AiTouristAgent.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AiTouristAgent</item>
    </style>
</resources>
