<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The droplet (§1.1 of ANDROID_APP_ARCHITECTURE.md) only serves plain HTTP on :3000.
         Android blocks cleartext traffic by default since API 28; scope the exception to
         just this IP instead of allowing cleartext app-wide. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">157.245.207.38</domain>
    </domain-config>
</network-security-config>
